---
import "../../styles.css";

const base = import.meta.env.BASE_URL;
const previewUrl = `${base}preview/`;
const appUrl = "https://app.synth.absmach.eu/login";
const docsUrl = "https://www.absmach.eu/docs/synth/user-guide/quick-start/";
const githubUrl = "https://github.com/absmach/synth";
const contactUrl = "https://www.absmach.eu/contact/";
const canonicalUrl = Astro.site ?? Astro.url;
const views = [
  { id: "board", label: "Build in conversation", image: "synth-live-board.png", alt: "Live Synth app showing the PCB board canvas with the design assistant conversation open alongside it", title: "Your board. Your next instruction.", description: "The canvas and conversation stay together. Ask a question or describe a change without losing your place." },
  { id: "3d", label: "3D view", image: "synth-live-3d.png", alt: "Live Synth app in 3D view mode showing the rendered PCB with components, same conversation panel open", title: "Another view. The same conversation.", description: "Switch between Board, Schematic, and 3D. The conversation and your unfinished message stay close." },
  { id: "checks", label: "Review checks", image: "synth-live-checks.png", alt: "Live Synth app checks workspace showing DRC findings and routing status for the current design", title: "Know what passed. Know what's open.", description: "Structured diagnostics tell you what's clear, what needs attention, and what the assistant can help fix." },
];
const prompts = [
  { label: "USB-C sensor logger", text: "Build a small USB-C environmental logger. Measure temperature, humidity and pressure, and leave room for a debug header." },
  { label: "Indoor air monitor", text: "I want a compact indoor air monitor with a temperature and humidity sensor, USB-C power, and a status LED." },
];
const details = [
  { icon: "{ }", title: "Source", text: "Open the circuit source when you want to look closer. Edit a draft, import a .synth file, or take the source with you." },
  { icon: "▦", title: "Parts & connections", text: "Explore the reference BOM, inspect component pins, and bring a part into the conversation when you have a question." },
  { icon: "⌁", title: "Physical settings", text: "Give the design its boundaries: board size, layers, placement requests, and routing preferences, all within reach." },
  { icon: "✓", title: "Checks & versions", text: "Inspect what has been checked, see what is still unknown, and return to an earlier snapshot as you explore." },
];
const plans = [
  {
    id: "free",
    name: "Free Beta",
    price: "€0",
    pricePeriod: "forever",
    description: "A safe starting point for trying Synth.",
    limits: [
      "3 projects per workspace",
      "5 synthesis jobs per hour",
      "20 assistant runs per hour",
      "10 manufacturing exports per hour",
    ],
    cta: "Start for free",
    primary: true,
  },
  {
    id: "pro",
    name: "Pro",
    price: "Coming soon",
    pricePeriod: null,
    description: "More room for individual design work.",
    limits: [
      "25 projects per workspace",
      "50 synthesis jobs per hour",
      "250 assistant runs per hour",
      "100 manufacturing exports per hour",
    ],
    cta: "Available soon",
    primary: false,
  },
  {
    id: "team",
    name: "Team",
    price: "Coming soon",
    pricePeriod: null,
    description: "Shared capacity for a small engineering team.",
    limits: [
      "250 projects per workspace",
      "200 synthesis jobs per hour",
      "1,000 assistant runs per hour",
      "1,000 manufacturing exports per hour",
    ],
    cta: "Talk to us",
    primary: false,
  },
];
const faqs = [
  { question: "Do I need to write circuit code?", answer: "No. Describe your board in plain language and the assistant turns it into a design proposal you can inspect and refine. Open Source, Parts, or Checks when you want engineering depth. The open-source compiler and MCP tools are a separate path for engineers who prefer a local, code-based workflow." },
  { question: "What does the live app let me do?", answer: "Open Synth to create a board from a description, work on the design through the assistant, switch between Schematic, Board, and 3D views, review diagnostics in Checks, and export KiCad files for manufacturing. The interactive concept on this page lets you explore the experience without an account." },
  { question: "Will I lose my conversation when I switch views?", answer: "No. One conversation stays beside the design canvas, schematic, and 3D view. Drafts stay with that session. On mobile, Board and Chat switch between surfaces. Your work is saved to your Synth account across sessions." },
  { question: "Can I keep working in KiCad?", answer: "Yes. The Synth compiler exports native KiCad schematics, PCB layouts, project files, and a BOM. Keep changes in the .synth source if you want them preserved on regeneration." },
  { question: "What is open source?", answer: "The Community compiler, CLI, MCP tools, and component registry are available under Apache-2.0. Run them locally, connect your own compatible agent, and inspect or extend the implementation. The managed Synth application builds on that foundation." },
  { question: "When is a board ready to manufacture?", answer: "A board needs engineering review and passed checks on the exact design revision before fabrication. The Synth compiler produces structured diagnostics distinguishing passed, failed, and unavailable checks. Manufacturing export produces Gerbers and a BOM once the design is approved." },
  { question: "How does the beta pricing work?", answer: "Synth is free during the beta. The Free plan gives you 3 projects, 5 synthesis jobs per hour, 20 assistant runs per hour, and 10 manufacturing exports per hour. Pro and Team plans are in planning and will unlock higher limits. Limits reset hourly." },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Your next board starts with a conversation. Explore Synth’s new PCB creation experience: a prompt, a board canvas, and engineering tools when you need them." />
    <meta name="theme-color" content="#fafbfe" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}fonts/dm-sans.ttf`} as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Synth — Your next board starts with a conversation." />
    <meta property="og:description" content="Describe your idea. Explore the board beside your conversation. Go deeper whenever you need to." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(`${base}images/concept-board.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Synth — Conversational PCB design</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href={base} aria-label="Synth home"><img src={`${base}images/synth-logo-monochrome.svg`} alt="Synth" width="114" height="27" /></a>
        <nav id="primary-nav" class="site-nav" aria-label="Primary navigation">
          <a href="#workspace">The experience</a>
          <a href="#details">Go deeper</a>
          <a href="#open-source">Open source</a>
          <a href="#pricing">Pricing</a>
          <a href={docsUrl}>Docs <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="button nav-cta" href={appUrl}>Open Synth <span aria-hidden="true">↗</span></a>
        <button class="menu-toggle" aria-label="Open navigation" aria-controls="primary-nav" aria-expanded="false"><span></span><span></span></button>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="wrap hero-inner">
          <h1 id="hero-title">Your next board.<br /><span>Just start talking.</span></h1>
          <p class="hero-lede">Describe what you want to build. Explore the board beside your conversation.<br class="desktop-break" /> Go deeper with engineering tools whenever you need them.</p>
          <form class="idea-box" action={previewUrl} method="get">
            <label class="sr-only" for="board-idea">Describe your board idea</label>
            <textarea id="board-idea" name="idea" rows="2" maxlength="2000" placeholder="A small USB-C board that measures the world around it…"></textarea>
            <div class="idea-bottom"><span><span class="spark" aria-hidden="true">✧</span> A LITTLE IDEA. SOMETHING REAL.</span><button class="button button-primary" type="submit">Preview your idea <span aria-hidden="true">↗</span></button></div>
          </form>
          <div class="idea-suggestions" aria-label="Example board ideas">
            {prompts.map(prompt => <button type="button" data-prompt={prompt.text}><span aria-hidden="true">+</span> {prompt.label}</button>)}
            <a href={appUrl}>Open the live app <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section id="workspace" class="workspace-section wrap" aria-labelledby="workspace-title">
        <div class="showcase-heading"><div><span class="eyebrow">FROM IDEA TO ELECTRONICS</span><h2 id="workspace-title">A place to think. A place to build.</h2></div><a class="text-link" href={appUrl}>Open the live app <span aria-hidden="true">↗</span></a></div>
        <div class="workspace-showcase">
          <div class="showcase-toolbar"><div class="project-label"><span class="project-icon" aria-hidden="true">✧</span><span>demo-rp2350-edge-logger-001 <small>LIVE APP</small></span></div><div class="view-tabs" role="tablist" aria-label="Explore the Synth app">
            {views.map(view => <button id={`tab-${view.id}`} role="tab" aria-selected={view.id === "board" ? "true" : "false"} aria-controls={`panel-${view.id}`} tabindex={view.id === "board" ? 0 : -1}>{view.label}</button>)}
          </div></div>
          {views.map(view => <div id={`panel-${view.id}`} role="tabpanel" aria-labelledby={`tab-${view.id}`} tabindex="0" hidden={view.id !== "board"} class="view-panel"><img src={`${base}images/${view.image}`} alt={view.alt} width="1280" height="800" loading="lazy" /><div class="view-caption"><h3>{view.title}</h3><p>{view.description}</p></div></div>)}
        </div>
        <div class="workspace-footnote"><p><span class="status-dot"></span> Screenshots from the live Synth application.</p><a href={appUrl}>Open Synth to build your own <span aria-hidden="true">↗</span></a></div>
        <div class="workflow-steps">
          <article><span>01 / DESCRIBE</span><h3>Start with what you imagine.</h3><p>A sensor board. A connected device. A first experiment. Put the idea into words and start from there.</p></article>
          <article><span>02 / DEVELOP</span><h3>Keep the conversation going.</h3><p>Ask questions, describe changes, and explore the board. The canvas and chat stay close together.</p></article>
          <article><span>03 / DELIVER</span><h3>Review and export.</h3><p>Check diagnostics, approve the design, and export KiCad schematics, layouts, and a BOM for manufacturing.</p></article>
        </div>
      </section>

      <section id="details" class="details-section section-pad">
        <div class="wrap details-layout">
          <div class="details-copy"><p class="eyebrow">SIMPLE TO START. ROOM TO GO DEEPER.</p><h2>Stay in the flow.<br /><span>Open the details.</span></h2><p>Keep the board and your conversation in view. Source, parts, connections, checks, and versions open in their own tabs when you want to look closer.</p><p>On a smaller screen, switch between Board and Chat. Your idea stays in the same conversation.</p><a class="text-link" href={appUrl}>Open the live app <span aria-hidden="true">↗</span></a></div>
          <div class="details-tools"><div class="details-bar"><span>Details</span><span class="details-badge">THERE WHEN YOU NEED THEM</span><span aria-hidden="true">⌄</span></div>{details.map((item, index) => <details class="tool-detail" open={index === 0}><summary><span class="tool-icon" aria-hidden="true">{item.icon}</span>{item.title}<span class="detail-plus" aria-hidden="true">+</span></summary><p>{item.text}</p></details>)}<p class="details-note">All of these tools are available in the live Synth app.</p></div>
        </div>
      </section>

      <section id="open-source" class="foundation-section section-pad">
        <div class="wrap">
          <div class="section-heading split-heading"><div><p class="eyebrow">OPEN ENGINEERING UNDERNEATH</p><h2>A simple beginning.<br />A solid foundation.</h2></div><p class="heading-aside">The conversational experience builds on Synth’s open compiler and agent tools. The engineering is there to inspect, run, and make your own.</p></div>
          <div class="foundation-grid">
            <article><span class="foundation-symbol" aria-hidden="true">{ }</span><h3>Readable circuit source.</h3><p>Parts, connections, and constraints live in .synth files. Inspect a design, review a diff, or keep it in Git.</p><a href={`${githubUrl}/tree/main/examples`}>Explore the examples <span aria-hidden="true">↗</span></a></article>
            <article><span class="foundation-symbol" aria-hidden="true">⌁</span><h3>Checks with useful answers.</h3><p>The compiler reports structured diagnostics that an engineer or agent can act on. Missing evidence stays visible.</p><a href={docsUrl}>Meet the compiler <span aria-hidden="true">↗</span></a></article>
            <article><span class="foundation-symbol" aria-hidden="true">↗</span><h3>A path into KiCad.</h3><p>The compiler exports native schematics, PCB layouts, and BOMs for inspection and downstream work.</p><a href={docsUrl}>Explore KiCad output <span aria-hidden="true">↗</span></a></article>
          </div>
          <div class="entry-grid">
            <article class="entry-card workspace-entry"><span class="entry-label">THE LIVE APPLICATION</span><h3>Open Synth.</h3><p>Sign in to create boards from a description, work through the assistant, review checks, and export for manufacturing.</p><a class="button button-primary" href={appUrl}>Open the live app <span aria-hidden="true">↗</span></a><a class="entry-secondary" href={previewUrl}>Try the interactive concept first <span aria-hidden="true">↗</span></a></article>
            <article class="entry-card compiler-entry"><span class="entry-label">THE OPEN-SOURCE COMPILER</span><h3>Build your own workflow.</h3><p>Run the compiler locally, connect your own MCP-compatible agent, and work directly with circuit source. Apache-2.0.</p><a class="button button-outline" href={docsUrl}>Use the open compiler <span aria-hidden="true">↗</span></a><a class="entry-secondary" href={githubUrl}>Explore the source on GitHub <span aria-hidden="true">↗</span></a></article>
          </div>
          <div class="team-note"><p>Building with a team? <span>Talk to us about managed Synth and engineering support.</span></p><a href={contactUrl}>Let’s talk <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section id="pricing" class="pricing-section section-pad">
        <div class="wrap">
          <div class="section-heading split-heading">
            <div><p class="eyebrow">FREE DURING BETA. SIMPLE LIMITS.</p><h2>Start free.<br /><span>Scale when ready.</span></h2></div>
            <p class="heading-aside">Synth is free to use during the beta. Limits reset hourly and apply per workspace. Pro and Team plans are in planning.</p>
          </div>
          <div class="plans-grid">
            {plans.map(plan => (
              <article class={`plan-card ${plan.primary ? "plan-card-primary" : ""}`}>
                <div class="plan-header">
                  <span class="plan-name">{plan.name}</span>
                  {plan.primary && <span class="plan-badge">CURRENT</span>}
                </div>
                <div class="plan-price">
                  <span class="plan-price-value">{plan.price}</span>
                  {plan.pricePeriod && <span class="plan-price-period">/ {plan.pricePeriod}</span>}
                </div>
                <p class="plan-description">{plan.description}</p>
                <ul class="plan-limits" role="list">
                  {plan.limits.map(limit => <li>{limit}</li>)}
                </ul>
                <a
                  class={`button ${plan.primary ? "button-primary" : "button-outline"} plan-cta`}
                  href={plan.primary ? appUrl : contactUrl}
                >
                  {plan.cta} <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))}
          </div>
          <p class="pricing-note">Paid plans are shown for planning only. Limits reset hourly. <a href={contactUrl}>Contact us</a> about team needs.</p>
        </div>
      </section>

      <section class="faq-section section-pad wrap" aria-labelledby="faq-title"><div><p class="eyebrow">A FEW GOOD QUESTIONS</p><h2 id="faq-title">Curiosity.<br />Encouraged.</h2><a class="text-link" href={docsUrl}>Go deeper in the docs <span aria-hidden="true">↗</span></a></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>

      <section class="closing-section"><div class="closing-grid" aria-hidden="true"></div><div class="wrap closing-inner"><p class="eyebrow">FROM YOUR FIRST “WHAT IF”</p><h2>What will you<br /><span>build next?</span></h2><p>A little idea is a good place to start.</p><div class="closing-actions"><a class="button button-primary" href={appUrl}>Open Synth <span aria-hidden="true">↗</span></a><a class="text-link" href={previewUrl}>Try the interactive concept</a></div><span class="closing-spark" aria-hidden="true">✳</span></div></section>
    </main>

    <footer class="site-footer"><div class="wrap footer-main"><div><a class="brand" href={base} aria-label="Synth home"><img src={`${base}images/synth-logo-monochrome.svg`} alt="Synth" width="114" height="27" /></a><p>A little idea. Something real.</p></div><div class="footer-links"><a href={appUrl}>Open Synth ↗</a><a href={previewUrl}>Interactive concept ↗</a><a href={githubUrl}>GitHub ↗</a><a href={docsUrl}>Documentation ↗</a><a href={contactUrl}>Get in touch ↗</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Synth. Built openly by <a href="https://www.absmach.eu/">Abstract Machines</a>.</span><div><a href="https://www.absmach.eu/privacy/">Privacy</a><span>Paris, France <span aria-hidden="true">↗</span></span></div></div></footer>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>(".site-nav");
      function closeMenu() {
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", "Open navigation");
        nav?.classList.remove("is-open");
      }
      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") !== "true";
        menuButton.setAttribute("aria-expanded", String(open));
        menuButton.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
        nav?.classList.toggle("is-open", open);
      });
      nav?.querySelectorAll("a").forEach(link => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", event => { if (event.key === "Escape") closeMenu(); });
      document.addEventListener("click", event => { if (!(event.target as Element).closest(".header-inner")) closeMenu(); });

      const tabs = [...document.querySelectorAll<HTMLButtonElement>(".view-tabs [role='tab']")];
      function activateTab(tab: HTMLButtonElement) {
        tabs.forEach(item => {
          const selected = item === tab;
          item.setAttribute("aria-selected", String(selected));
          item.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(item.getAttribute("aria-controls") || "");
          if (panel) panel.hidden = !selected;
        });
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activateTab(tab));
        tab.addEventListener("keydown", event => {
          let target = index;
          if (event.key === "ArrowRight") target = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") target = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") target = 0;
          else if (event.key === "End") target = tabs.length - 1;
          else return;
          event.preventDefault(); activateTab(tabs[target]); tabs[target].focus();
        });
      });

      const idea = document.querySelector<HTMLTextAreaElement>("#board-idea");
      document.querySelectorAll<HTMLButtonElement>("[data-prompt]").forEach(button => {
        button.addEventListener("click", () => {
          if (!idea) return;
          idea.value = button.dataset.prompt || "";
          idea.focus({ preventScroll: true });
        });
      });
    </script>
  </body>
</html>
