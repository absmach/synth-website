---
import "../../styles.css";
import "../styles/showcase.css";
import { boards } from "../data/showcase";
import SiteHeader from "../components/SiteHeader.astro";

const base = import.meta.env.BASE_URL;
const appUrl = "https://app.synth.absmach.eu/login";
const betaUrl = "https://app.synth.absmach.eu/api/beta-requests";
const docsUrl = "https://www.absmach.eu/docs/synth/user-guide/quick-start/";
const githubUrl = "https://github.com/absmach/synth";
const contactUrl = "https://www.absmach.eu/contact/";
const canonicalUrl = Astro.site ?? Astro.url;
const socialImage = new URL(`${base}images/og-usb-uart.jpg`, Astro.site);
const views = [
  { id: "home", label: "Start with an idea", image: "synth-live-home.png", alt: "Current light-mode Synth Projects page with the start-with-an-idea board brief form", title: "Start with the board in mind.", description: "Begin with a plain-language brief, then carry it into the full review workspace when you are ready." },
  { id: "3d", label: "3D view", image: "synth-live-3d.png", alt: "Live Synth app in 3D view mode showing the rendered PCB with components, same conversation panel open", title: "Another view. The same conversation.", description: "Switch between Board, Schematic, and 3D. The conversation and your unfinished message stay close." },
  { id: "checks", label: "Review checks", image: "synth-live-checks.png", alt: "Live Synth app checks workspace showing DRC findings and routing status for the current design", title: "Know what passed. Know what's open.", description: "Structured diagnostics tell you what's clear, what needs attention, and what the assistant can help fix." },
];
const details = [
  { icon: "{ }", title: "Source", text: "Open the circuit source when you want to look closer. Edit a draft, import a .synth file, or take the source with you." },
  { icon: "▦", title: "Parts & connections", text: "Explore the reference BOM, inspect component pins, and bring a part into the conversation when you have a question." },
  { icon: "⌁", title: "Physical settings", text: "Give the design its boundaries: board size, layers, placement requests, and routing preferences, all within reach." },
  { icon: "✓", title: "Checks & versions", text: "Inspect what has been checked, see what is still unknown, and return to an earlier snapshot as you explore." },
];
const faqs = [
  { question: "Do I need to write circuit code?", answer: "No. Describe your board in plain language and the assistant turns it into a design proposal you can inspect and refine. Open Source, Parts, or Checks when you want engineering depth. The open-source compiler and MCP tools are a separate path for engineers who prefer a local, code-based workflow." },
  { question: "What does the live app let me do?", answer: "Open Synth to create a board from a description, work on the design through the assistant, switch between Schematic, Board, and 3D views, review diagnostics in Checks, and export KiCad files for manufacturing. The public site shows the workflow; the live app is where the work happens." },
  { question: "Will I lose my conversation when I switch views?", answer: "No. One conversation stays beside the design canvas, schematic, and 3D view. Drafts stay with that session. On mobile, Board and Chat switch between surfaces. Your work is saved to your Synth account across sessions." },
  { question: "Can I keep working in KiCad?", answer: "Yes. The Synth compiler exports native KiCad schematics, PCB layouts, project files, and a BOM. Keep changes in the .synth source if you want them preserved on regeneration." },
  { question: "What is open source?", answer: "The Community compiler, CLI, MCP tools, and component registry are available under Apache-2.0. Run them locally, connect your own compatible agent, and inspect or extend the implementation. The managed Synth application builds on that foundation." },
  { question: "When is a board ready to manufacture?", answer: "A board needs engineering review and passed checks on the exact design revision before fabrication. The Synth compiler produces structured diagnostics distinguishing passed, failed, and unavailable checks. Manufacturing export produces Gerbers and a BOM once the design is approved." },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Synth is conversational PCB design for embedded teams. Describe a board, inspect the design, review engineering checks, and continue in KiCad." />
    <meta name="theme-color" content="#fafbfe" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}fonts/dm-sans.ttf`} as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Synth — Conversational PCB design for embedded teams." />
    <meta property="og:description" content="Describe a board, inspect the design, review engineering checks, and continue in KiCad." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="The USB-C dual UART and RS-485 adapter board rendered in 3D" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="The USB-C dual UART and RS-485 adapter board rendered in 3D" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Synth — Conversational PCB design for embedded teams</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader
      docsUrl={docsUrl}
      appUrl={appUrl}
      links={[
        { href: "#showcase", label: "Showcase" },
        { href: "#workspace", label: "The experience" },
        { href: "#open-source", label: "Open source" },
        { href: "#beta", label: "Beta access" },
      ]}
    />

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="wrap hero-inner">
          <p class="eyebrow">CONVERSATIONAL PCB DESIGN FOR EMBEDDED TEAMS</p>
          <h1 id="hero-title">Your next board.<br /><span>Just start talking.</span></h1>
          <p class="hero-lede">Start with a brief, inspect the design beside your conversation, and hand off to KiCad when it is time to build.<br class="desktop-break" /> Synth keeps the engineering visible as the idea becomes a board.</p>
          <div class="closing-actions hero-actions">
            <a class="button button-primary" href={appUrl}>Open the live workspace <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#workspace">See how it works <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section id="showcase" class="showcase-section wrap" aria-labelledby="showcase-title">
        <div class="showcase-heading"><div><span class="eyebrow">MADE WITH SYNTH</span><h2 id="showcase-title">Real boards. Open files.</h2></div><a class="text-link" href={githubUrl}>Source on GitHub <span aria-hidden="true">↗</span></a></div>
        <div class="sc-cards">
          {boards.map(board => <a class="sc-card" href={`${base}showcase/${board.slug}/`}>
            <div class="sc-card-image"><img src={`${base}showcase/${board.slug}/${board.assets.render}`} alt={board.renderAlt} width="1600" height="1100" loading="lazy" /></div>
            <div class="sc-card-copy"><h3>{board.title}</h3><p>{board.tagline}</p><p class="sc-card-facts">{board.stats.map(s => `${s.label} ${s.value}`).join(" · ")}<br />{board.status}</p><span class="sc-card-go">Open the board page <span aria-hidden="true">→</span></span></div>
          </a>)}
        </div>
      </section>

      <section id="workspace" class="workspace-section wrap" aria-labelledby="workspace-title">
        <div class="showcase-heading"><div><span class="eyebrow">FROM IDEA TO ELECTRONICS</span><h2 id="workspace-title">A place to think. A place to build.</h2></div><a class="text-link" href={appUrl}>Open the live app <span aria-hidden="true">↗</span></a></div>
        <div class="workspace-showcase">
          <div class="showcase-toolbar"><div class="project-label"><span class="project-icon" aria-hidden="true">✧</span><span>demo-rp2350-edge-logger-001 <small>LIVE APP</small></span></div><div class="view-tabs" role="tablist" aria-label="Explore the Synth app">
            {views.map(view => <button id={`tab-${view.id}`} role="tab" aria-selected={view.id === "home" ? "true" : "false"} aria-controls={`panel-${view.id}`} tabindex={view.id === "home" ? 0 : -1}>{view.label}</button>)}
          </div></div>
          {views.map(view => <div id={`panel-${view.id}`} role="tabpanel" aria-labelledby={`tab-${view.id}`} tabindex="0" hidden={view.id !== "home"} class="view-panel"><img src={`${base}images/${view.image}`} alt={view.alt} width="1280" height="800" loading="lazy" /><div class="view-caption"><h3>{view.title}</h3><p>{view.description}</p></div></div>)}
        </div>
        <div class="workspace-footnote"><p><span class="status-dot"></span> Screenshots from the live Synth application.</p><a href={appUrl}>Open Synth to build your own <span aria-hidden="true">↗</span></a></div>
        <div class="workflow-steps">
          <article><span>01 / DESCRIBE</span><h3>Start with what you imagine.</h3><p>A sensor board. A connected device. A first experiment. Put the idea into words and start from there.</p></article>
          <article><span>02 / DEVELOP</span><h3>Keep the conversation going.</h3><p>Ask questions, describe changes, and explore the board. The canvas and chat stay close together.</p></article>
          <article><span>03 / DELIVER</span><h3>Review and export.</h3><p>Check diagnostics, approve the design, and export KiCad schematics, layouts, and a BOM for manufacturing.</p></article>
        </div>
      </section>

      <section id="details" class="details-section section-pad">
        <div class="wrap details-layout">
          <div class="details-copy"><p class="eyebrow">SIMPLE TO START. ROOM TO GO DEEPER.</p><h2>Stay in the flow.<br /><span>Open the details.</span></h2><p>Keep the board and your conversation in view. Source, parts, connections, checks, and versions open in their own tabs when you want to look closer.</p><p>On a smaller screen, switch between Board and Chat. Your idea stays in the same conversation.</p><a class="text-link" href={appUrl}>Open the live app <span aria-hidden="true">↗</span></a></div>
          <div class="details-tools"><div class="details-bar"><span>Details</span><span class="details-badge">THERE WHEN YOU NEED THEM</span><span aria-hidden="true">⌄</span></div>{details.map((item, index) => <details class="tool-detail" open={index === 0}><summary><span class="tool-icon" aria-hidden="true">{item.icon}</span>{item.title}<span class="detail-plus" aria-hidden="true">+</span></summary><p>{item.text}</p></details>)}<p class="details-note">All of these tools are available in the live Synth app.</p></div>
        </div>
      </section>

      <section id="open-source" class="foundation-section section-pad">
        <div class="wrap">
          <div class="section-heading split-heading"><div><p class="eyebrow">OPEN ENGINEERING UNDERNEATH</p><h2>A simple beginning.<br />A solid foundation.</h2></div><p class="heading-aside">The conversational experience builds on Synth’s open compiler and agent tools. The engineering is there to inspect, run, and make your own.</p></div>
          <div class="foundation-grid">
            <article><span class="foundation-symbol" aria-hidden="true">{ }</span><h3>Readable circuit source.</h3><p>Parts, connections, and constraints live in .synth files. Inspect a design, review a diff, or keep it in Git.</p><a href={`${githubUrl}/tree/main/examples`}>Explore the examples <span aria-hidden="true">↗</span></a></article>
            <article><span class="foundation-symbol" aria-hidden="true">⌁</span><h3>Checks with useful answers.</h3><p>The compiler reports structured diagnostics that an engineer or agent can act on. Missing evidence stays visible.</p><a href={docsUrl}>Meet the compiler <span aria-hidden="true">↗</span></a></article>
            <article><span class="foundation-symbol" aria-hidden="true">↗</span><h3>A path into KiCad.</h3><p>The compiler exports native schematics, PCB layouts, and BOMs for inspection and downstream work.</p><a href={docsUrl}>Explore KiCad output <span aria-hidden="true">↗</span></a></article>
          </div>
          <div class="entry-grid">
            <article class="entry-card workspace-entry"><span class="entry-label">THE LIVE APPLICATION</span><h3>Open Synth.</h3><p>Sign in to create boards from a description, work through the assistant, review checks, and export for manufacturing.</p><a class="button button-primary" href={appUrl}>Open the live app <span aria-hidden="true">↗</span></a></article>
            <article class="entry-card compiler-entry"><span class="entry-label">THE OPEN-SOURCE COMPILER</span><h3>Build your own workflow.</h3><p>Run the compiler locally, connect your own MCP-compatible agent, and work directly with circuit source. Apache-2.0.</p><a class="button button-outline" href={docsUrl}>Use the open compiler <span aria-hidden="true">↗</span></a><a class="entry-secondary" href={githubUrl}>Explore the source on GitHub <span aria-hidden="true">↗</span></a></article>
          </div>
          <div class="team-note"><p>Building with a team? <span>Talk to us about managed Synth and engineering support.</span></p><a href={contactUrl}>Let’s talk <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section class="launch-section section-pad" aria-labelledby="launch-title">
        <div class="wrap">
          <div class="section-heading split-heading">
            <div><p class="eyebrow">A CLEAR PATH TO PRODUCTION</p><h2 id="launch-title">Start with intent.<br /><span>Finish with evidence.</span></h2></div>
            <p class="heading-aside">Synth helps teams move from an idea to a reviewable electronics design. The managed app is the fastest way in; the open compiler keeps the work inspectable and portable.</p>
          </div>
          <div class="entry-grid launch-path-grid">
            <article class="entry-card workspace-entry"><span class="entry-label">BUILD IN THE MANAGED APP</span><h3>Turn a brief into a board.</h3><p>Describe the device, work beside the canvas, and keep the conversation attached to the design as it develops.</p><a class="button button-primary" href={appUrl}>Open Synth <span aria-hidden="true">↗</span></a></article>
            <article class="entry-card compiler-entry"><span class="entry-label">KEEP THE ENGINEERING OPEN</span><h3>Inspect, export, continue.</h3><p>Review source and diagnostics, then take native KiCad files and a BOM into the tools your team already trusts.</p><a class="button button-outline" href={docsUrl}>Read the engineering docs <span aria-hidden="true">↗</span></a></article>
          </div>
        </div>
      </section>

      <section class="faq-section section-pad wrap" aria-labelledby="faq-title"><div><p class="eyebrow">A FEW GOOD QUESTIONS</p><h2 id="faq-title">Curiosity.<br />Encouraged.</h2><a class="text-link" href={docsUrl}>Go deeper in the docs <span aria-hidden="true">↗</span></a></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>

      <section id="beta" class="beta-section section-pad" aria-labelledby="beta-title">
        <div class="wrap beta-layout">
          <div class="beta-copy"><p class="eyebrow">PRIVATE BETA</p><h2 id="beta-title">Bring us the board<br /><span>you want to build.</span></h2><p>Tell us what you are working on. We are opening Synth gradually and will follow up when a workspace is a good fit.</p><p class="beta-note">A request is not an account or a promise of access. We only use your details to review the request and contact you about Synth.</p><a class="text-link" href={appUrl}>Already have access? Open Synth <span aria-hidden="true">↗</span></a></div>
          <form class="beta-form" data-beta-form action={betaUrl} method="post">
            <label for="beta-name">Name</label>
            <input id="beta-name" name="name" type="text" autocomplete="name" maxlength="100" required />
            <label for="beta-email">Email</label>
            <input id="beta-email" name="email" type="email" autocomplete="email" maxlength="254" required />
            <label for="beta-idea">What are you building? <span>(optional)</span></label>
            <textarea id="beta-idea" name="idea" rows="4" maxlength="1200" placeholder="A small USB-C environmental logger…"></textarea>
            <label class="beta-trap" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
            <button class="button button-primary" type="submit"><span>Request beta access</span><span aria-hidden="true">→</span></button>
            <p class="beta-status" data-beta-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
      <section class="closing-section"><div class="closing-grid" aria-hidden="true"></div><div class="wrap closing-inner"><p class="eyebrow">FROM YOUR FIRST “WHAT IF”</p><h2>What will you<br /><span>build next?</span></h2><p>A little idea is a good place to start.</p><div class="closing-actions"><a class="button button-primary" href="#beta">Request beta access <span aria-hidden="true">↓</span></a></div><span class="closing-spark" aria-hidden="true">✳</span></div></section>
    </main>

    <footer class="site-footer"><div class="wrap footer-main"><div><a class="brand" href={base} aria-label="Synth home"><img src={`${base}images/synth-logo-monochrome.svg`} alt="Synth" width="114" height="27" /></a><p>A little idea. Something real.</p></div><div class="footer-links"><a href={appUrl}>Open Synth ↗</a><a href={githubUrl}>GitHub ↗</a><a href={docsUrl}>Documentation ↗</a><a href={contactUrl}>Get in touch ↗</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Synth. Built openly by <a href="https://www.absmach.eu/">Abstract Machines</a>.</span><div><a href="https://www.absmach.eu/privacy/">Privacy</a><span>Paris, France <span aria-hidden="true">↗</span></span></div></div></footer>

    <script>
      const liveAppUrl = "https://app.synth.absmach.eu/login";
      const tabs = [...document.querySelectorAll<HTMLButtonElement>(".view-tabs [role='tab']")];
      function activateTab(tab: HTMLButtonElement) {
        tabs.forEach(item => {
          const selected = item === tab;
          item.setAttribute("aria-selected", String(selected));
          item.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(item.getAttribute("aria-controls") || "");
          if (panel) panel.hidden = !selected;
        });
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activateTab(tab));
        tab.addEventListener("keydown", event => {
          let target = index;
          if (event.key === "ArrowRight") target = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") target = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") target = 0;
          else if (event.key === "End") target = tabs.length - 1;
          else return;
          event.preventDefault(); activateTab(tabs[target]); tabs[target].focus();
        });
      });

      document.querySelectorAll<HTMLFormElement>("[data-beta-form]").forEach(form => {
        const status = form.querySelector<HTMLElement>("[data-beta-status]");
        form.addEventListener("submit", async event => {
          event.preventDefault();
          if (!status) return;
          const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
          if (button) button.disabled = true;
          status.textContent = "Sending your request…";
          try {
            const response = await fetch(form.action, { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.error || "We could not save your request.");
            form.innerHTML = `<p class="beta-success-eyebrow">REQUEST RECEIVED</p><h3>Thanks. We have your note.</h3><p>We will review the board you described and email you if Synth is a good fit for the next beta group.</p><a class="button button-primary" href="${liveAppUrl}">Already have access? Open Synth <span aria-hidden="true">↗</span></a>`;
          } catch (error) {
            status.textContent = error instanceof Error ? error.message : "We could not save your request. Please try again.";
            if (button) button.disabled = false;
          }
        });
      });

    </script>
  </body>
</html>
