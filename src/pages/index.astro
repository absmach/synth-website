---
import "../../styles.css";

const base = import.meta.env.BASE_URL;
const appUrl = "https://app.synth.absmach.eu/login";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Synth is your PCB design copilot, from first idea to fabrication evidence." />
    <meta name="theme-color" content="#10131a" />
    <title>Synth — Your PCB design copilot</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Synth home"><img src={`${base}images/synth-logo-monochrome.svg`} alt="Synth" /></a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href={`${base}#workflow`}>How it works</a>
        <a href={`${base}#control`}>Built for review</a>
        <a href="https://www.absmach.eu/docs/synth/user-guide/quick-start/">Docs <span aria-hidden="true">↗</span></a>
        <a class="nav-cta" href={appUrl}>Open Synth <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero section-wrap">
        <div class="hero-copy">
          <p class="eyebrow">PCB design, with a point of view</p>
          <h1>From first idea to a board you can explain.</h1>
          <p class="hero-lede">Synth helps you turn a product brief into an inspectable circuit, a constrained layout, and evidence you can review before anything gets handed off.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={appUrl}>Start designing <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href={`${base}#workflow`}>See the workflow</a>
          </div>
          <p class="hero-note">AI proposes. You approve the design.</p>
        </div>
        <div class="hero-art video-art">
          <div class="window-bar"><span class="window-dot"></span><span>Synth in motion</span><span class="window-status">real workspace · reviewable output</span></div>
          <video class="product-film" autoplay muted loop playsinline preload="metadata" poster={`${base}images/synth-product-film-poster.png`} aria-label="Synth workspace recording showing PCB design, 3D review, checks, and the home workspace">
            <source src={`${base}images/synth-product-film.mp4`} type="video/mp4" />
          </video>
          <div class="hero-art-footer"><span>Brief</span><span>Design</span><span>Checks</span><span>Deliver</span><strong>AI proposes · you approve</strong></div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Synth product principles">
        <div class="section-wrap proof-grid"><span>Brief to board</span><span>Revision-aware</span><span>Human approval</span><span>KiCad-native output</span></div>
      </section>

      <section class="evidence-section">
        <div class="section-wrap evidence-layout">
          <div class="evidence-copy"><p class="eyebrow">The product, in the product</p><h2>See the board. See the reasoning.</h2><p>Synth keeps the design surface and its review context together. These are real workspace views: the routed board, a 3D inspection, and the review surface that sits around them.</p><a class="text-link" href="https://www.absmach.eu/docs/synth/user-guide/quick-start/">Read the quick start <span aria-hidden="true">↗</span></a></div>
          <div class="screenshot-grid" aria-label="Synth workspace screenshots">
            <figure class="product-shot product-shot-tall"><img src={`${base}images/synth-live-board.png`} alt="Live Synth workspace showing a routed RP2350 Edge Logger PCB" loading="lazy" /><figcaption>Design view · RP2350 Edge Logger</figcaption></figure>
            <figure class="product-shot"><img src={`${base}images/synth-live-3d.png`} alt="Live Synth workspace showing the RP2350 Edge Logger in 3D" loading="lazy" /><figcaption>3D view · inspect the physical board</figcaption></figure>
            <figure class="product-shot"><img src={`${base}images/synth-live-checks.png`} alt="Live Synth workspace showing review checks and routing status" loading="lazy" /><figcaption>Checks view · routing and physical review</figcaption></figure>
          </div>
        </div>
      </section>

      <section id="workflow" class="section-wrap workflow-section">
        <div class="section-heading"><p class="eyebrow">A clearer path through complexity</p><h2>Keep the conversation close to the board.</h2><p>Every step leaves an understandable trail. Move quickly without making the important decisions invisible.</p></div>
        <div class="workflow-grid">
          <article class="workflow-card"><span class="step-number">01</span><h3>Brief</h3><p>Describe what you want to build. Confirm interfaces, power, mechanical constraints, and the assumptions that matter.</p><span class="card-arrow" aria-hidden="true">↗</span></article>
          <article class="workflow-card"><span class="step-number">02</span><h3>Plan</h3><p>Review the proposed architecture, parts, placement, and tradeoffs before a new revision is created.</p><span class="card-arrow" aria-hidden="true">↗</span></article>
          <article class="workflow-card"><span class="step-number">03</span><h3>Build</h3><p>Generate revision-bound KiCad artifacts and route with the external engine that fits the job.</p><span class="card-arrow" aria-hidden="true">↗</span></article>
          <article class="workflow-card"><span class="step-number">04</span><h3>Review</h3><p>Follow findings back to the design, inspect provenance, and decide what is ready for handoff.</p><span class="card-arrow" aria-hidden="true">↗</span></article>
        </div>
      </section>

      <section class="editor-section">
        <div class="section-wrap editor-layout">
          <div class="editor-copy"><p class="eyebrow">The workspace, in context</p><h2>One place to ask, inspect, and decide.</h2><p>Keep the assistant beside the working design—not in a chat window detached from it. Every proposal has a scope, every finding points somewhere, and every accepted change has a revision.</p><a class="text-link" href={appUrl}>Explore the workspace <span aria-hidden="true">↗</span></a></div>
          <figure class="product-shot product-shot-feature"><img src={`${base}images/synth-live-checks.png`} alt="Live Synth workspace showing review checks for the RP2350 Edge Logger" loading="lazy" /><figcaption>Live workspace capture · review the board from the same surface as the design</figcaption></figure>
        </div>
      </section>

      <section id="control" class="feature-section">
        <div class="section-wrap feature-layout">
          <div><p class="eyebrow">Designed for trust</p><h2>Powerful enough for engineers. Clear enough for everyone in the room.</h2></div>
          <div class="feature-list">
            <div><span class="feature-icon" aria-hidden="true">↗</span><div><h3>Revision-bound evidence</h3><p>Checks, artifacts, notes, and decisions stay attached to the exact design they describe.</p></div></div>
            <div><span class="feature-icon" aria-hidden="true">◇</span><div><h3>Human approval at every turn</h3><p>Proposals remain proposals until you review and accept them. The accepted design is protected.</p></div></div>
            <div><span class="feature-icon" aria-hidden="true">⌁</span><div><h3>Direct control when you need it</h3><p>Edit source, constrain placement, inspect nets, and challenge the assistant without leaving the workspace.</p></div></div>
          </div>
        </div>
      </section>

      <section class="faq-section section-wrap">
        <div class="section-heading"><p class="eyebrow">Good questions</p><h2>Useful before you trust it with a board.</h2></div>
        <div class="faq-grid">
          <details open><summary>Does Synth replace an electrical engineer?</summary><p>No. Synth accelerates the design work and makes its assumptions visible. You remain responsible for review and approval of the exact revision.</p></details>
          <details><summary>Can I work without the Copilot?</summary><p>Yes. Source editing, placement constraints, routing controls, checks, and exports remain direct engineering tools in the workspace.</p></details>
          <details><summary>What happens when a route fails?</summary><p>Synth keeps the prior geometry, identifies the external router, and marks the result for review instead of presenting a failure as fabrication-ready.</p></details>
          <details><summary>What do I get at handoff?</summary><p>Revision-bound KiCad artifacts, checks, routing evidence, provenance, and a package review surface. Manufacturing readiness is only claimed when the exact revision supports it.</p></details>
        </div>
      </section>

      <section class="closing section-wrap">
        <p class="eyebrow">The next board starts with a sentence.</p>
        <h2>Make electronics feel understandable, creative, and precise.</h2>
        <div class="closing-actions">
          <a class="button button-primary" href={appUrl}>Open the Synth workspace <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="https://www.absmach.eu/docs/synth/user-guide/quick-start/">Read the quick start <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer section-wrap"><a class="brand" href={base}><img src={`${base}images/synth-logo-monochrome.svg`} alt="Synth" /></a><span>Your PCB design copilot, from first idea to fabrication.</span><span>© 2026 Synth</span></footer>
    <script>
      const revealItems = document.querySelectorAll(".evidence-copy, .product-shot, .workflow-card, .editor-copy, .feature-list > div, .faq-grid details");
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });
      revealItems.forEach((item, index) => {
        (item as HTMLElement).style.setProperty("--reveal-delay", `${Math.min(index % 4, 3) * 70}ms`);
        revealObserver.observe(item);
      });

      const hero = document.querySelector<HTMLElement>(".hero-art");
      if (hero && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        hero.addEventListener("pointermove", (event: PointerEvent) => {
          const bounds = hero.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width - 0.5;
          const y = (event.clientY - bounds.top) / bounds.height - 0.5;
          hero.style.setProperty("--tilt-x", `${y * -2}deg`);
          hero.style.setProperty("--tilt-y", `${x * 2}deg`);
        });
        hero.addEventListener("pointerleave", () => {
          hero.style.setProperty("--tilt-x", "0deg");
          hero.style.setProperty("--tilt-y", "0deg");
        });
      }
    </script>
  </body>
</html>
