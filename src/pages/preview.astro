---
const appUrl = "https://app.synth.absmach.eu/login";
const idea = Astro.url.searchParams.get("idea");
const handoffUrl = new URL(appUrl);
if (idea) handoffUrl.searchParams.set("brief", idea);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Open the live Synth workspace to create and review a board." />
    <meta http-equiv="refresh" content={`0;url=${handoffUrl.toString()}`} />
    <title>Synth — Open the live workspace</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body style="font-family: sans-serif; padding: 3rem; color: #172033;">
    <main>
      <h1>Opening the live Synth workspace…</h1>
      <p>The interactive concept has been retired. Continue in the real Synth application.</p>
      <p><a href={handoffUrl.toString()}>Open Synth</a></p>
    </main>
  </body>
</html>
