---
import "../../../styles.css";
import "../../styles/showcase.css";
import { boards } from "../../data/showcase";
import type { Board } from "../../data/showcase";

export function getStaticPaths() {
  return boards.map((board) => ({ params: { slug: board.slug }, props: { board } }));
}

const { board } = Astro.props as { board: Board };
const base = import.meta.env.BASE_URL;
const appUrl = "https://app.synth.absmach.eu/login";
const docsUrl = "https://www.absmach.eu/docs/synth/user-guide/quick-start/";
const canonicalUrl = Astro.site ? new URL(`${base}showcase/${board.slug}/`, Astro.site) : Astro.url;
const dir = `${base}showcase/${board.slug}/`;
const asset = (name: string) => `${dir}${name}`;
const texts = import.meta.glob<string>("../../../public/showcase/*/*.{synth,txt,md}", { query: "?raw", import: "default", eager: true });
const onDisk = (name: string) => texts[`../../../public/showcase/${board.slug}/${name}`] ?? "";

const sourceText = onDisk(board.source.file).trimEnd();
const sourceLineCount = sourceText.split("\n").length;
const promptText = onDisk("prompt.md");
const licenseParagraphs = onDisk("LICENSE-NOTES.md").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const zipFile = `${board.slug}-files.zip`;
const lineage = [
  { id: "prompt", label: "Prompt" },
  { id: "source", label: "Source" },
  { id: "board", label: "Board" },
  { id: "checks", label: "Checks" },
  { id: "files", label: "Files" },
  { id: "status", label: "Status" },
];
const facts = board.stats.map((s) => `${s.label} ${s.value}`).join(" · ");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${board.title}: a real board made with Synth. ${board.tagline} Source, KiCad files, 3D model, prompt, AI model and checks, with what is not verified.`} />
    <meta name="theme-color" content="#fafbfe" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}fonts/dm-sans.ttf`} as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${board.title} — made with Synth`} />
    <meta property="og:description" content={board.tagline} />
    <meta property="og:url" content={canonicalUrl} />
    {Astro.site && <meta property="og:image" content={new URL(asset(board.assets.render), Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{board.title} — Synth showcase</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href={base} aria-label="Synth home"><img src={`${base}images/synth-logo-monochrome.svg`} alt="Synth" width="114" height="27" /></a>
        <nav id="primary-nav" class="site-nav" aria-label="Primary navigation">
          <a href={`${base}#showcase`}>Showcase</a>
          <a href={`${base}#workspace`}>The experience</a>
          <a href={`${base}#open-source`}>Open source</a>
          <a href={docsUrl}>Docs <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="button nav-cta" href={appUrl}>Open Synth <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="sc-top wrap" aria-labelledby="board-title">
        <p class="sc-crumb"><a href={`${base}#showcase`}>Showcase</a> <span aria-hidden="true">/</span> <span>Made with Synth</span></p>
        <h1 id="board-title">{board.title}</h1>
        <p class="sc-tagline">{board.tagline}</p>
        <p class="sc-facts">{facts}</p>
        <p class="sc-status-note">{board.status}</p>
      </section>

      <section class="sc-viewer wrap" aria-label="Interactive 3D view" data-board-viewer data-glb={asset(board.assets.glb)} data-label={`3D view of ${board.title}. ${board.renderAlt}`}>
        <div class="sc-stage" data-viewer-stage>
          <img data-viewer-fallback src={asset(board.assets.render)} alt={board.renderAlt} width="1600" height="1100" fetchpriority="high" />
          <div class="sc-controls" role="group" aria-label="3D view controls" hidden>
            <button type="button" class="sc-btn" data-view="top" aria-pressed="false">Top</button>
            <button type="button" class="sc-btn" data-view="angled" aria-pressed="true">Angled</button>
            <button type="button" class="sc-btn" data-view="bottom" aria-pressed="false">Bottom</button>
            <button type="button" class="sc-btn" data-spin aria-pressed="true">Auto-rotate</button>
          </div>
        </div>
        <p class="sc-status" data-viewer-status role="status"></p>
      </section>

      <nav class="sc-lineage wrap" aria-label="From prompt to files">
        <ol>
          {lineage.map((step) => <li><a href={`#${step.id}`}>{step.label}</a></li>)}
        </ol>
      </nav>

      <section id="prompt" class="sc-section wrap" aria-labelledby="prompt-title">
        <div class="sc-side"><h2 id="prompt-title">The brief</h2><p>What the AI was asked, and with what.</p></div>
        <div class="sc-body">
          <p class="sc-lede">{board.summary}</p>
          <h3>The brief in one sentence</h3>
          <p class="sc-quote">{board.prompt.summary}</p>
          <p>{board.prompt.note}</p>
          <details class="sc-details">
            <summary>Read the prompt you can run</summary>
            <div class="sc-codebar"><button type="button" class="sc-btn" data-copy data-copy-target="prompt-text">Copy prompt</button><a class="text-link" href={asset("prompt.md")} download>Download prompt.md</a></div>
            <pre id="prompt-text" class="sc-code sc-brief" tabindex="0" aria-label="Prompt text">{promptText}</pre>
          </details>
          <p><a class="text-link" href={asset("brief.txt")} download>Original agent brief, word for word <span aria-hidden="true">↓</span></a></p>
          <h3>Model and tools</h3>
          <dl class="sc-dl">
            <div><dt>AI model</dt><dd>{board.model}</dd></div>
            {board.tools.map((tool) => <div><dt>{tool.name}</dt><dd>{tool.use}</dd></div>)}
          </dl>
        </div>
      </section>

      <section id="source" class="sc-section wrap" aria-labelledby="source-title">
        <div class="sc-side"><h2 id="source-title">The source</h2><p>The board is a plain-text file. Synth compiles it to a KiCad project.</p></div>
        <div class="sc-body">
          <p>The whole file, <code>{board.source.file}</code>, {sourceLineCount} lines. Scroll the box, or copy the file.</p>
          <div class="sc-codebar"><button type="button" class="sc-btn" data-copy data-copy-url={asset(board.source.file)}>Copy full {board.source.file}</button><a class="text-link" href={asset(board.source.file)} download>Download {board.source.file}</a></div>
          <pre class="sc-code" tabindex="0" aria-label={`The full text of ${board.source.file}`}><code>{sourceText}</code></pre>
        </div>
      </section>

      <section id="board" class="sc-section wrap" aria-labelledby="board-sec-title">
        <div class="sc-side"><h2 id="board-sec-title">The board</h2><p>Schematic, all four copper layers and parts, from the same files.</p></div>
        <div class="sc-body">
          <figure class="sc-figure sc-figure-wide">
            <img src={asset(board.assets.schematic)} alt={board.schematicAlt} loading="lazy" />
            <figcaption>Schematic, drawn by Synth. It is a wide sheet, so zoom in to read the text. <span class="sc-tools"><a class="sc-link" href={asset(board.assets.schematic)} target="_blank" rel="noopener" data-zoom={asset(board.assets.schematic)} data-alt={board.schematicAlt}>Zoom</a><a class="sc-link" href={asset(board.assets.schematic)} download>Download SVG</a></span></figcaption>
          </figure>
          <div class="sc-pair">
            <figure class="sc-figure sc-layers" data-layers>
              <div class="sc-tabs" role="tablist" aria-label="Copper layers">
                {board.layers.map((layer, i) => <a role="tab" id={`layer-tab-${layer.id}`} class="sc-tab" href={asset(layer.file)} target="_blank" rel="noopener" aria-controls="layer-panel" data-layer={layer.id} data-file={asset(layer.file)} data-alt={layer.alt} data-note={layer.note} aria-selected={i === 0 ? "true" : "false"}>{layer.label}</a>)}
              </div>
              <div id="layer-panel" role="tabpanel" aria-labelledby={`layer-tab-${board.layers[0].id}`} data-layer-panel>
              <img data-layer-img src={asset(board.layers[0].file)} alt={board.layers[0].alt} loading="lazy" />
              <figcaption><span data-layer-note>{board.layers[0].note}</span> <span class="sc-tools"><a class="sc-link" data-layer-zoom href={asset(board.layers[0].file)} target="_blank" rel="noopener" data-zoom={asset(board.layers[0].file)} data-alt={board.layers[0].alt}>Zoom</a><a class="sc-link" data-layer-download href={asset(board.layers[0].file)} download>Download SVG</a></span></figcaption>
              </div>
            </figure>
            <div>
              <h3>Parts</h3>
              <table class="sc-table">
                <caption class="sr-only">Main parts</caption>
                <thead class="sr-only"><tr><th>Reference</th><th>Part</th><th>Role</th></tr></thead>
                <tbody>
                  {board.parts.map((p) => <tr><th scope="row">{p.ref}</th><td>{p.name}</td><td>{p.role}</td></tr>)}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <section id="checks" class="sc-section wrap" aria-labelledby="checks-title">
        <div class="sc-side"><h2 id="checks-title">Checks</h2><p>What was measured, and what was not.</p></div>
        <div class="sc-body sc-checks">
          <div>
            <h3>Measured</h3>
            <dl class="sc-dl">
              {board.checks.map((c) => <div><dt>{c.label}</dt><dd>{c.value}</dd></div>)}
            </dl>
          </div>
          <div class="sc-limits">
            <h3>Not claimed</h3>
            <ul>
              {board.limits.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="files" class="sc-section wrap" aria-labelledby="files-title">
        <div class="sc-side"><h2 id="files-title">Files</h2><p>Everything on this page, to open in your own tools.</p></div>
        <div class="sc-body">
          <p class="sc-zip"><a class="button button-primary" href={asset(zipFile)} download>Download everything (.zip) <span aria-hidden="true">↓</span></a></p>
          <ul class="sc-files">
            {board.files.map((f) => <li><a href={asset(f.path)}><span>{f.label}</span><small>{f.note}</small><code>{f.path}</code></a></li>)}
          </ul>
          <h3>License</h3>
          {licenseParagraphs.map((para) => <p>{para}</p>)}
          <p><a class="text-link" href={`${base}#showcase`}>Back to the showcase <span aria-hidden="true">←</span></a></p>
        </div>
      </section>
      <section id="status" class="sc-section wrap" aria-labelledby="status-title">
        <div class="sc-side"><h2 id="status-title">Status</h2><p>What this board is, and is not.</p></div>
        <div class="sc-body">
          <div class="sc-draft" data-qualification>
            <p>{board.qualification.text}</p>
            <p class="sc-draft-links">{board.qualification.evidence.map((e) => <a class="text-link" href={asset(e.path)}>{e.label}</a>)}</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="wrap footer-main"><div><a class="brand" href={base} aria-label="Synth home"><img src={`${base}images/synth-logo-monochrome.svg`} alt="Synth" width="114" height="27" /></a><p>A little idea. Something real.</p></div><div class="footer-links"><a href={appUrl}>Open Synth ↗</a><a href="https://github.com/absmach/synth">GitHub ↗</a><a href={docsUrl}>Documentation ↗</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Synth. Built openly by <a href="https://www.absmach.eu/">Abstract Machines</a>.</span></div></footer>

    <dialog class="sc-lightbox" data-lightbox aria-label="Zoomed image">
      <div class="sc-lb-bar">
        <button type="button" class="sc-btn" data-lb="in" aria-label="Zoom in">+</button>
        <button type="button" class="sc-btn" data-lb="out" aria-label="Zoom out">−</button>
        <button type="button" class="sc-btn" data-lb="reset">Reset</button>
        <a class="sc-btn" data-lb="download" href="#" download>Download</a>
        <button type="button" class="sc-btn" data-lb="close">Close</button>
      </div>
      <div class="sc-lb-stage" data-lb-stage tabindex="0"></div>
    </dialog>
    <p class="sr-only" role="status" data-copy-status></p>

    <script>
      import "../../scripts/board-viewer";
      import "../../scripts/figure-tools";
      import "../../scripts/layer-tabs";
    </script>
  </body>
</html>
